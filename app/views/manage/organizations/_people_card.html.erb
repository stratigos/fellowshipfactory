<turbo-frame id="organization-people-overlay">
  <div
    class="fixed inset-0 z-50 flex items-center justify-center bg-black/40"
    data-controller="overlay"
  >
    <div class="w-full max-w-md rounded-lg bg-white p-6 shadow-xl">
      <div class="mb-4 flex items-center justify-between">
        <h2 class="text-lg font-semibold">
          People in <%= organization.name %>
        </h2>

        <a
          href="#"
          data-action="click->overlay#close"
          class="text-slate-500 hover:text-slate-700"
        >✖️</a>
      </div>

      <ul class="space-y-2">
        <% presented_people.each do |person| %>
          <li class="rounded border border-blue-500 px-3 py-2">
            <div class="font-medium"><%= person.lname_fname %></div>
          </li>
        <% end %>
      </ul>
    </div>
  </div>
</turbo-frame>
